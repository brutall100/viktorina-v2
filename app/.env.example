# Viktorina v2 – settings for the FULL (server) version.
# Copy this file:  cp .env.example .env   and fill in your own values.
# Never commit the real .env file.

# Where the project folder is served by Apache/XAMPP (no trailing slash)
APP_URL=http://localhost/viktorina-v2

# MySQL / MariaDB connection (used by PHP pages and Node servers)
DB_HOST=localhost
DB_PORT=3306
DB_USER=viktorina_user
DB_PASSWORD=change-me
DB_DATABASE=viktorina

# Gmail account that sends welcome / password-reset emails
MAIL_USER=your-address@example.com
MAIL_PASS=your-app-password
MAIL_ADDRESS=your-address@example.com

# Ports of the Node servers
# PORT0 auth, PORT1 quiz, PORT3 mini-game, PORT4 points, PORT5 chat, PORT6 profile
PORT0=4000
PORT1=4001
PORT3=4003
PORT4=4004
PORT5=4005
PORT6=4006
